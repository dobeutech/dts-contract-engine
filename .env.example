# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Adobe Sign (replaces DocuSeal)
# Base URI comes from your Adobe Sign account: Admin > API > REST API > Base URI
ADOBE_SIGN_BASE_URI=https://api.na1.adobesign.com
ADOBE_SIGN_INTEGRATION_KEY=
# The client ID shown in your Adobe Sign integration registration (used for webhook verification)
ADOBE_SIGN_WEBHOOK_CLIENT_ID=
# Optional but strongly recommended: HMAC-SHA256 secret for per-payload signing.
# When set, the webhook handler verifies X-AdobeSign-ClientSecret-Sha256 against
# HMAC-SHA256(rawBody, this secret). Without it, only the static client id is
# checked, which is replayable. Configure in Adobe Sign → Account → Webhooks.
ADOBE_SIGN_WEBHOOK_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend (transactional email)
RESEND_API_KEY=
# Email addresses used by src/lib/integrations/email.ts
NOTIFICATIONS_FROM_EMAIL="dobeu contracts <contracts@dobeu.tech>"
NOTIFICATIONS_TEAM_EMAIL=jeremyw@dobeu.net

# Intercom (Client Portal Support)
NEXT_PUBLIC_INTERCOM_APP_ID=
INTERCOM_ACCESS_TOKEN=

# Client portal token signing
CLIENT_PORTAL_JWT_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Sentry (error monitoring; leave blank to disable)
# Get these from https://sentry.io/settings/<org>/projects/<project>/keys/
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Auth token for source-map upload at build time (production+preview only).
# Create at https://sentry.io/settings/account/api/auth-tokens/ with project:write scope.
SENTRY_AUTH_TOKEN=

# Playwright e2e (used in CI; locally optional)
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

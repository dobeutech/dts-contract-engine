# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Adobe Sign (replaces DocuSeal)
# Base URI comes from your Adobe Sign account: Admin > API > REST API > Base URI
ADOBE_SIGN_BASE_URI=https://api.na1.adobesign.com
ADOBE_SIGN_INTEGRATION_KEY=
# The client ID shown in your Adobe Sign integration registration (used for webhook verification)
ADOBE_SIGN_WEBHOOK_CLIENT_ID=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend (transactional email)
RESEND_API_KEY=
# Email addresses used by src/lib/integrations/email.ts
NOTIFICATIONS_FROM_EMAIL="dobeu contracts <contracts@dobeu.tech>"
NOTIFICATIONS_TEAM_EMAIL=jeremyw@dobeu.net

# Intercom (Client Portal Support)
NEXT_PUBLIC_INTERCOM_APP_ID=
INTERCOM_ACCESS_TOKEN=

# Client portal token signing
CLIENT_PORTAL_JWT_SECRET=

# MongoDB Atlas — webhook payload archive + audit events.
# Use a dedicated database user with readWrite on the target db only.
# Rotate immediately if this value is ever pasted into chat, logs, or a PR.
MONGODB_URI=
# Optional. Defaults to "dts_contract_engine". The db name embedded in
# MONGODB_URI is intentionally ignored; this var is the only way to
# override the default.
MONGODB_DB_NAME=dts_contract_engine

# Bearer token required by /api/internal/webhook-payloads on top of the
# Supabase session check. Treat as a service-to-service secret —
# generate with `openssl rand -base64 48` and store only in Vercel env.
# A missing value causes the endpoint to return 503 (fail-closed).
INTERNAL_API_BEARER_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Sentry (error monitoring; leave blank to disable)
# Get these from https://sentry.io/settings/<org>/projects/<project>/keys/
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Auth token for source-map upload at build time (production+preview only).
# Create at https://sentry.io/settings/account/api/auth-tokens/ with project:write scope.
SENTRY_AUTH_TOKEN=

# Playwright e2e (used in CI; locally optional)
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

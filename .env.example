# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Adobe Sign (replaces DocuSeal)
ADOBE_SIGN_API_KEY=
ADOBE_SIGN_WEBHOOK_SECRET=
ADOBE_SIGN_BASE_URL=https://api.na1.adobesign.com/api/rest/v6

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Dobeu Tech Solutions <hello@dobeu.dev>"

# Intercom (Client Portal Support)
NEXT_PUBLIC_INTERCOM_APP_ID=
INTERCOM_ACCESS_TOKEN=

# Client portal token signing
CLIENT_PORTAL_JWT_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Sentry (error monitoring; leave blank to disable)
# Get these from https://sentry.io/settings/<org>/projects/<project>/keys/
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Auth token for source-map upload at build time (production+preview only).
# Create at https://sentry.io/settings/account/api/auth-tokens/ with project:write scope.
SENTRY_AUTH_TOKEN=

# Playwright e2e (used in CI; locally optional)
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

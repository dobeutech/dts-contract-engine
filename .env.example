# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# DocuSeal (free tier at https://www.docuseal.com)
DOCUSEAL_API_KEY=
DOCUSEAL_WEBHOOK_SECRET=
DOCUSEAL_BASE_URL=https://api.docuseal.com

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Dobeu Tech Solutions <hello@dobeu.dev>"

# Customer.io (optional — for client lifecycle automation)
CUSTOMERIO_SITE_ID=
CUSTOMERIO_TRACK_API_KEY=

# Client portal token signing
CLIENT_PORTAL_JWT_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Sentry (error monitoring; leave blank to disable)
# Get these from https://sentry.io/settings/<org>/projects/<project>/keys/
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Auth token for source-map upload at build time (production+preview only).
# Create at https://sentry.io/settings/account/api/auth-tokens/ with project:write scope.
SENTRY_AUTH_TOKEN=

# Playwright e2e (used in CI; locally optional)
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
